<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="512dp"
            android:height="512dp"
            android:viewportWidth="512"
            android:viewportHeight="512">

            <!-- Outer Stator Ring -->
            <path
                android:name="path_stator"
                android:pathData="M 256,96 A 160,160 0 1,0 256,416 A 160,160 0 1,0 256,96 Z"
                android:strokeColor="#00F0FF"
                android:strokeWidth="10" />

            <!-- 8 Radial Telemetry Pins -->
            <path
                android:name="path_pins"
                android:pathData="M 256,64 L 256,96 M 256,416 L 256,448 M 64,256 L 96,256 M 416,256 L 448,256 M 120,120 L 144,144 M 368,368 L 392,392 M 392,120 L 368,144 M 120,392 L 144,368"
                android:strokeColor="#00F0FF"
                android:strokeWidth="8" />

            <!-- 8 Gold Coil Stator Accents -->
            <path
                android:name="path_coils"
                android:pathData="M 192,109 L 204,138 M 320,109 L 308,138 M 109,192 L 138,204 M 109,320 L 138,308 M 192,403 L 204,374 M 320,403 L 308,374 M 403,192 L 374,204 M 403,320 L 374,308"
                android:strokeColor="#FFB700"
                android:strokeWidth="12" />

            <!-- Inner Floating Containment Ring -->
            <path
                android:name="path_inner_ring"
                android:pathData="M 256,146 A 110,110 0 1,0 256,366 A 110,110 0 1,0 256,146 Z"
                android:strokeColor="#4D9FFF"
                android:strokeWidth="8" />

            <!-- 3 Laser Conduits -->
            <path
                android:name="path_conduits"
                android:pathData="M 176,210 L 150,184 M 336,210 L 362,184 M 256,348 L 256,384"
                android:strokeColor="#00F0FF"
                android:strokeWidth="8" />

            <!-- Central Mark VI Triangle Core -->
            <path
                android:name="path_core_triangle"
                android:pathData="M 176,210 L 336,210 L 256,348 Z"
                android:fillColor="#00F0FF" />

            <!-- Inner Aperture Flare -->
            <path
                android:name="path_inner_flare"
                android:pathData="M 200,226 L 312,226 L 256,322 Z"
                android:fillColor="#FFFFFF" />

            <!-- Arc Core Diamond -->
            <path
                android:name="path_arc_diamond"
                android:pathData="M 256,240 L 272,258 L 256,276 L 240,258 Z"
                android:fillColor="#FFB700" />
        </vector>
    </aapt:attr>

    <!-- Subtle Stator Pulse Animation -->
    <target android:name="path_core_triangle">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.4"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="path_inner_flare">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.3"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
